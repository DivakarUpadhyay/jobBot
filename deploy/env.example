# Copy to deploy/.env on the server and fill in. Never commit the filled-in file.
DOMAIN=jobpilot.example.com
ADMIN_DOMAIN=admin.jobpilot.example.com
JOBBOT_PUBLIC_URL=https://jobpilot.example.com

# Encryption key for stored mailbox passwords and tokens. Make one with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Keep a copy somewhere safe and apart from the backups: without it the stored passwords cannot be read.
JOBBOT_SECRET_KEY=

# AI used to tailor resumes
GEMINI_API_KEY=
ANTHROPIC_API_KEY=

# Operations
JOBBOT_ALERT_EMAIL=
JOBBOT_BACKUP_HOUR=3
JOBBOT_BACKUP_KEEP=7
JOBBOT_METRICS_TOKEN=

# Mailbox sign-in (OAuth); the redirect address to register with each provider is JOBBOT_PUBLIC_URL/oauth/callback
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
MICROSOFT_OAUTH_CLIENT_ID=
MICROSOFT_OAUTH_CLIENT_SECRET=

# Payments; webhooks: JOBBOT_PUBLIC_URL/webhooks/razorpay and JOBBOT_PUBLIC_URL/webhooks/stripe
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Shown in the Terms of Service and Privacy Policy
JOBBOT_COMPANY_NAME=
JOBBOT_COMPANY_ADDRESS=
JOBBOT_SUPPORT_EMAIL=
JOBBOT_PRIVACY_EMAIL=
JOBBOT_GRIEVANCE_OFFICER=
JOBBOT_JURISDICTION=India
JOBBOT_COURTS=
JOBBOT_REFUND_POLICY=
JOBBOT_HOSTING=
