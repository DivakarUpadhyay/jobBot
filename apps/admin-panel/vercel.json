{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "crons": [
    { "path": "/api/cron", "schedule": "30 0 * * *" }
  ],
  "redirects": [
    { "source": "/app", "destination": "https://jobbot-portal.vercel.app/", "permanent": false }
  ],
  "rewrites": [
    { "source": "/admin", "destination": "/index.html" },
    { "source": "/console", "destination": "/console.html" },
    { "source": "/((?!api/cron$).*)", "destination": "https://BACKEND-NOT-SET.invalid/$1" }
  ],
  "headers": [
    {
      "source": "/(|admin|console)",
      "headers": [
        { "key": "Content-Security-Policy", "value": "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src 'self'; frame-ancestors 'none'; base-uri 'none'; form-action 'self'; object-src 'none'" },
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "Referrer-Policy", "value": "no-referrer" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=(), payment=()" }
      ]
    }
  ]
}
